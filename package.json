{
  "name": "care-hub",
  "version": "1.0.0",
  "private": true,
  "description": "C.A.R.E. Hub - Campus Anonymous Reporting & Escalation Hub",
  "type": "module",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qgacabrera-bit/C.A.R.E-Hub.git"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
