# Copy to .env - `npm start` loads it automatically. Never commit .env.
PORT=3000
# Required in production (NODE_ENV=production): 12+ characters. The server refuses to start otherwise.
ADMIN_PASSCODE=change-me-to-something-long
# Set to 1 when running behind a hosting proxy (Render, Railway, Fly, nginx) so rate limits are per visitor.
TRUST_PROXY=0
# AI features (optional). auto = use an AI model when a key is set; off = offline rules only
CARE_LLM=auto
# Which AI: auto (Gemini if GEMINI_API_KEY is set, else Claude), gemini, or anthropic
CARE_LLM_PROVIDER=auto
# Google Gemini - use a key from a billing-enabled project for real student data (see README)
# Put your real key in .env (never here - this file is committed to GitHub).
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest
# Anthropic Claude
# ANTHROPIC_API_KEY=sk-ant-...
RETAIN_RAW_CONTENT=false
# Database: Supabase Postgres. Use the Transaction pooler string (Supabase > Connect > Transaction pooler).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F ...).
# Put the real value in .env or your host's secret settings - never commit it.
# Leave empty for local development: an embedded Postgres is stored under data/pglite.
# DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
# Max pooled connections per server instance (default 5).
# DB_POOL_MAX=5
# Load synthetic demo data into an empty database at startup (set to false for a real pilot).
# CARE_SEED=true
