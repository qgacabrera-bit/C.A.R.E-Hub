# Copy to .env - `npm start` loads it automatically. Never commit .env.
PORT=3000
# Required in production (NODE_ENV=production): 12+ characters. The server refuses to start otherwise.
ADMIN_PASSCODE=change-me-to-something-long
# Set to 1 when running behind a hosting proxy (Render, Railway, Fly, nginx) so rate limits are per visitor.
TRUST_PROXY=0
# auto = use Claude when ANTHROPIC_API_KEY is set; off = offline rules only
CARE_LLM=auto
# ANTHROPIC_API_KEY=sk-ant-...
RETAIN_RAW_CONTENT=false
# CARE_DB_PATH=data/care-hub.db
